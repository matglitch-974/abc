#!/bin/sh
# bcai — commande de BCAI (Linux, Alpine sous Termux ; Windows : bcai.cmd).
set -eu
DEST="$HOME/ai/2-tools/3-software/bcai"
AI="$HOME/ai"
PY=$(command -v python3 || command -v python)

usage() {
  cat <<'TXT'
bcai install            installe ou met à jour BCAI (dernière version de GitHub) ; alias : bcai update
bcai uninstall          désinstalle, après deux confirmations (puis deux autres avant toute suppression)
bcai status             état : versions, configuration, recherche, sauvegardes
bcai backup [list]      sauvegarde immédiate, ou liste des sauvegardes
bcai search "requête"   recherche web (SearXNG local) ; options : bcai search -h
bcai keys open|close|status   coffre chiffré de 2-tools/4-keys-code (restic)
bcai import [skills|agents|secrets|llm]   réimporte l'existant (copies ; idempotent)
bcai version            version installée
TXT
}

case "${1:-}" in
  install|update)
    shift
    # install.sh met à jour le dépôt (git pull) puis relance l'installation ; aucune donnée écrasée.
    if [ -d "$DEST/.git" ]; then git -C "$DEST" pull -q --ff-only || echo "ATTENTION : mise à jour Git impossible, version locale utilisée" >&2; fi
    exec sh "$DEST/install.sh" "$@" ;;
  uninstall)
    exec sh "$DEST/uninstall.sh" ;;
  backup)
    if [ "${2:-}" = list ]; then exec "$PY" "$DEST/hooks/bcai-backup.py" list; fi
    exec "$PY" "$DEST/hooks/bcai-backup.py" quotidienne ;;
  search)
    shift; exec "$PY" "$AI/2-tools/1-skills/search/search.py" "$@" ;;
  keys)
    shift; exec "$PY" "$DEST/hooks/bcai-keys.py" "$@" ;;
  import)
    shift; [ $# -eq 0 ] && set -- all; exec "$PY" "$DEST/hooks/bcai-import.py" "$@" ;;
  version)
    V=$(cat "$DEST/VERSION" 2>/dev/null || echo '?')
    git -C "$DEST" log -1 --format="BCAI $V %h (%cs)" 2>/dev/null || echo "BCAI $V : dépôt Git introuvable ($DEST)" ;;
  status)
    V=$(cat "$DEST/VERSION" 2>/dev/null || echo '?')
    git -C "$DEST" log -1 --format="BCAI         $V %h (%cs)" 2>/dev/null || echo "BCAI         introuvable"
    printf 'Claude Code  %s\n' "$(claude --version 2>/dev/null || echo absent)"
    printf 'config       %s %s\n' "${CLAUDE_CONFIG_DIR:-NON DÉFINIE}" \
      "$([ "${CLAUDE_CONFIG_DIR:-}" = "$AI/2-tools/3-software/claude-code" ] && echo '(ok)' || echo '(ouvrir un nouveau terminal)')"
    [ -e "$HOME/.claude" ] && echo "ATTENTION    ~/.claude existe : cache laissé par une session hors BCAI, rangé dans 4-trash au prochain démarrage de claude"
    printf 'recherche    %s\n' "$("$PY" "$AI/2-tools/1-skills/search/search.py" status 2>/dev/null || echo 'SearXNG absent')"
    printf 'sauvegardes  %s\n' "$("$PY" "$DEST/hooks/bcai-backup.py" list 2>/dev/null | wc -l | tr -d ' ') ($AI/2-tools/logs/backup-bcai)"
    if command -v restic >/dev/null 2>&1; then printf 'restic       %s\n' "$(restic version | cut -d' ' -f2)"
    else echo "restic       absent (sauvegardes en tar.xz)"; fi ;;
  ""|-h|--help|help)
    usage ;;
  *)
    echo "bcai : commande inconnue « $1 »" >&2; usage >&2; exit 1 ;;
esac
